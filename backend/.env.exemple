# LLM
OPENAI_API_KEY=sk-proj-REMPLACE_PAR_TA_VRAIE_CLE
# LiteLLM routing
LITELLM_DEFAULT_MODEL=gpt-5.4
LITELLM_CHEAP_MODEL=gpt-5.4-mini

# Base de données (Docker local)
DATABASE_URL=postgresql+asyncpg://narr8:narr8dev@localhost:5432/narr8
DATABASE_URL_SYNC=postgresql://narr8:narr8dev@localhost:5432/narr8

# Redis (Docker local)
REDIS_URL=redis://localhost:6379/0

# Storage MinIO (Docker local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_BUCKET=narr8-dev

# App
APP_ENV=development
SECRET_KEY=dev-secret-change-in-prod
DEBUG=true

# HITL seuils
HITL_CONFIDENCE_THRESHOLD=0.80
HITL_METADATA_CONFIDENCE_THRESHOLD=0.85
HITL_ORPHAN_RATE_THRESHOLD=0.05

# Power BI Desktop local (MCP) — v1+, optionnel (source de données alternative au CSV)
# Nécessite Power BI Desktop ouvert avec le fichier ci-dessous chargé, et Node.js/npx installé.
POWERBI_MCP_COMMAND=npx
POWERBI_MCP_ARGS=-y @microsoft/powerbi-modeling-mcp@latest --start
POWERBI_PBIX_FILE_NAME=
# false (défaut) : ajoute --require-confirmation au serveur MCP (confirmations actives).
# true : omet ce flag (le serveur SKIPPE les confirmations par défaut) — dev itératif
# uniquement, pas en prod. Piloter aussi le comportement du callback MCP Elicitation
# côté client (accepte auto si true, décline sinon).
POWERBI_MCP_SKIP_CONFIRMATION=false
# "llm" : notre prompt LiteLLM génère le DAX. "mcp_native" : tool DAX du serveur MCP.
POWERBI_DAX_GENERATION_MODE=llm

# RAG schéma sémantique (pgvector) — mode powerbi_local uniquement, voir README.md
SCHEMA_RAG_EMBEDDING_MODEL=text-embedding-3-small
# Nombre de champs de schéma retournés par retrieve_relevant_fields — ajustable sans
# redéploiement. Valeur de départ (voir README.md pour la justification empirique).
SCHEMA_RAG_K=15
SCHEMA_RAG_HASH_TTL_SECONDS=2592000