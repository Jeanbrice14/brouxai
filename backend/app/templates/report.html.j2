<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ prompt | truncate(80) }} — BrouxAI</title>

  <!-- Chart.js — pas de dépendance React, CDN stable -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    /* ── Variables CSS brand_kit ─────────────────────────────── */
    :root {
      --color-primary:  {{ colors.primary }};
      --color-positive: {{ colors.positive }};
      --color-negative: {{ colors.negative }};
      --color-bg:       #f8f9fa;
      --color-surface:  #ffffff;
      --color-text:     #1a1a1a;
      --color-muted:    #6b7280;
      --radius:         8px;
    }

    /* ── Reset & base ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.65;
      font-size: 16px;
    }

    /* ── Layout ──────────────────────────────────────────────── */
    .page-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* ── Header ──────────────────────────────────────────────── */
    .report-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1.5rem;
      border-bottom: 3px solid var(--color-primary);
      margin-bottom: 2rem;
      gap: 1rem;
    }
    .report-header .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .report-header .brand img {
      max-height: 48px;
      max-width: 160px;
      object-fit: contain;
    }
    .report-header .company-name {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-primary);
    }
    .report-header .report-date {
      font-size: 0.875rem;
      color: var(--color-muted);
      white-space: nowrap;
    }

    /* ── Titre principal ─────────────────────────────────────── */
    .report-title {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .report-subtitle {
      font-size: 0.9rem;
      color: var(--color-muted);
      margin-bottom: 2rem;
    }

    /* ── Carte générique ─────────────────────────────────────── */
    .card {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 1.5rem 1.75rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07);
    }
    .card-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--color-muted);
      margin-bottom: 0.75rem;
    }

    /* ── Résumé exécutif ─────────────────────────────────────── */
    .executive-summary p {
      font-size: 1.05rem;
      font-weight: 500;
      line-height: 1.7;
    }

    /* ── Section graphiques ──────────────────────────────────── */
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
      gap: 1.5rem;
      margin-bottom: 1.75rem;
    }
    .chart-card {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07);
    }
    .chart-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--color-text);
    }
    .chart-container {
      width: 100%;
      height: 280px;
      position: relative;
    }
    .chart-container canvas {
      display: block;
    }

    /* ── Narration ───────────────────────────────────────────── */
    .narrative-section p {
      margin-bottom: 1rem;
      line-height: 1.8;
    }
    .narrative-section p:last-child { margin-bottom: 0; }

    /* ── Pied de page ────────────────────────────────────────── */
    .report-footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
      font-size: 0.8rem;
      color: var(--color-muted);
      text-align: center;
    }

    /* ── Impression ──────────────────────────────────────────── */
    @media print {
      body { background: white; font-size: 12pt; }
      .page-wrapper { max-width: 100%; padding: 0; }
      .card, .chart-card {
        box-shadow: none;
        border: 1px solid #e5e7eb;
        break-inside: avoid;
      }
      .charts-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 600px) {
      .charts-grid { grid-template-columns: 1fr; }
      .report-title { font-size: 1.35rem; }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">

    <!-- ── En-tête ─────────────────────────────────────────── -->
    <header class="report-header">
      <div class="brand">
        {% if logo_url %}
        <img src="{{ logo_url }}" alt="Logo" />
        {% endif %}
        {% if company_name %}
        <span class="company-name">{{ company_name }}</span>
        {% endif %}
      </div>
      <span class="report-date">{{ report_date }}</span>
    </header>

    <!-- ── Titre ───────────────────────────────────────────── -->
    <h1 class="report-title">{{ prompt }}</h1>
    <p class="report-subtitle">Rapport #{{ report_id }}</p>

    <!-- ── Résumé exécutif ─────────────────────────────────── -->
    {% if paragraphs %}
    <div class="card executive-summary">
      <div class="card-title">Résumé exécutif</div>
      <p>{{ paragraphs[0] }}</p>
    </div>
    {% endif %}

    <!-- ── Graphiques ─────────────────────────────────────── -->
    {% if viz_specs %}
    <div class="charts-grid">
      {% for spec in viz_specs %}
      <div class="chart-card">
        <div class="chart-title">{{ spec.title }}</div>
        <div class="chart-container">
          <canvas id="chart-{{ loop.index0 }}"></canvas>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- ── Narration complète ─────────────────────────────── -->
    <div class="card narrative-section">
      <div class="card-title">Analyse complète</div>
      {% for para in paragraphs %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>

    <!-- ── Pied de page ────────────────────────────────────── -->
    <footer class="report-footer">
      Généré par BrouxAI &mdash; {{ report_id }} &mdash; {{ report_date }}
    </footer>

  </div><!-- /.page-wrapper -->

  <!-- ── Données viz injectées côté serveur ─────────────── -->
  <script>
    window.__VIZ_SPECS__ = {{ viz_specs_json | safe }};
    window.__BRAND_COLORS__ = {
      primary:  "{{ colors.primary | safe }}",
      positive: "{{ colors.positive | safe }}",
      negative: "{{ colors.negative | safe }}"
    };
  </script>

  <!-- ── Rendu Chart.js ──────────────────────────────────── -->
  <script>
  (function () {
    if (typeof Chart === "undefined") {
      console.warn("BrouxAI: Chart.js non chargé — graphiques désactivés.");
      return;
    }

    var specs  = window.__VIZ_SPECS__ || [];
    var colors = window.__BRAND_COLORS__;

    var PIE_PALETTE = [
      colors.primary  || "#1E3A8A",
      colors.positive || "#16A34A",
      colors.negative || "#DC2626",
      "#8B5CF6", "#F59E0B", "#0EA5E9", "#EC4899"
    ];

    function getColor(spec) {
      var c = spec.colors || {};
      return c.primary || colors.primary || "#1E3A8A";
    }

    function getLabels(data, key) {
      return data.map(function(row) { return row[key] !== undefined ? row[key] : ""; });
    }

    function getValues(data, key) {
      return data.map(function(row) { return Number(row[key]) || 0; });
    }

    function renderBar(canvas, spec, data) {
      var color = getColor(spec);
      new Chart(canvas, {
        type: "bar",
        data: {
          labels: getLabels(data, spec.x),
          datasets: [{
            label: spec.y,
            data: getValues(data, spec.y),
            backgroundColor: color + "cc",
            borderColor: color,
            borderWidth: 1,
            borderRadius: 4
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, grid: { color: "#f0f0f0" } }, x: { grid: { display: false } } }
        }
      });
    }

    function renderLine(canvas, spec, data) {
      var color = getColor(spec);
      new Chart(canvas, {
        type: "line",
        data: {
          labels: getLabels(data, spec.x),
          datasets: [{
            label: spec.y,
            data: getValues(data, spec.y),
            borderColor: color,
            backgroundColor: color + "22",
            borderWidth: 2,
            pointRadius: 4,
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: false, grid: { color: "#f0f0f0" } }, x: { grid: { display: false } } }
        }
      });
    }

    function renderPie(canvas, spec, data) {
      new Chart(canvas, {
        type: "pie",
        data: {
          labels: getLabels(data, spec.x),
          datasets: [{
            data: getValues(data, spec.y),
            backgroundColor: PIE_PALETTE.slice(0, data.length),
            borderWidth: 1
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } }
        }
      });
    }

    function renderScatter(canvas, spec, data) {
      var color = getColor(spec);
      var points = data.map(function(row) {
        return { x: Number(row[spec.x]) || 0, y: Number(row[spec.y]) || 0 };
      });
      new Chart(canvas, {
        type: "scatter",
        data: { datasets: [{ label: spec.title || "", data: points, backgroundColor: color + "99", borderColor: color }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { grid: { color: "#f0f0f0" } }, y: { grid: { color: "#f0f0f0" } } }
        }
      });
    }

    var renderers = {
      bar:       renderBar,
      line:      renderLine,
      pie:       renderPie,
      scatter:   renderScatter,
      histogram: renderBar
    };

    specs.forEach(function(spec, idx) {
      var canvas = document.getElementById("chart-" + idx);
      if (!canvas) return;
      var data = Array.isArray(spec.data) ? spec.data : [];
      if (data.length === 0) {
        canvas.parentElement.innerHTML = "<p style='color:#6b7280;font-size:0.85rem;padding:1rem'>Aucune donnée disponible.</p>";
        return;
      }
      var fn = renderers[spec.chart_type] || renderBar;
      try {
        fn(canvas, spec, data);
      } catch (e) {
        canvas.parentElement.innerHTML = "<p style='color:#6b7280;font-size:0.85rem;padding:1rem'>Graphique non disponible.</p>";
        console.error("BrouxAI chart error [" + idx + "]:", e);
      }
    });

  })();
  </script>

</body>
</html>
